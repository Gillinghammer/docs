      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "quickstart"
            ]
          },
          {
            "group": "Using Agents",
            "pages": [
              "consumers/setup",
              "consumers/claude-desktop",
              "consumers/claude-code",
              "consumers/first-agent",
              "consumers/wallet-setup",
              "consumers/payment-methods"
            ]
          },
          {
            "group": "Building Agents",
            "pages": [
              "builders/overview",
              "builders/register-agent",
              "builders/mcp-schema",
              "builders/endpoint-requirements",
              "builders/signing-secret"
            ]
          }
        ]
      },
      {
        "tab": "MCP Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "mcp/overview"
            ]
          },
          {
            "group": "Tools",
            "pages": [
              "mcp/tools/solve",
